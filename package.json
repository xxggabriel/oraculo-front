{
  "name": "oraculo-front",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.8.0"
  },
  "scripts": {
    "start": "ng serve --host 127.0.0.1 --proxy-config proxy.conf.json",
    "build": "ng build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint src scripts tests && node scripts/check-boundaries.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "contracts:sync": "node scripts/contracts.mjs sync",
    "contracts:check": "node scripts/contracts.mjs check",
    "check": "npm run contracts:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "format": "prettier --write \"src/**/*.{ts,css,html}\""
  },
  "dependencies": {
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/platform-browser": "21.2.25",
    "@angular/router": "21.2.25",
    "@tailwindcss/postcss": "4.3.3",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "htmlparser2": "10.1.0",
    "postcss": "8.5.29",
    "rxjs": "7.8.2",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@angular/build": "21.2.26",
    "@angular/cli": "21.2.26",
    "@angular/compiler-cli": "21.2.25",
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.56.1",
    "eslint": "9.39.1",
    "happy-dom": "20.0.11",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vitest": "4.0.8"
  }
}
